#!/usr/bin/env bpftrace

#define O_ACCMODE 00000003
#define O_RDONLY  00000000
#define O_WRONLY  00000001
#define O_RDWR    00000002

/*
 * Executed programs
 */
tracepoint:sched:sched_process_exec
/cgroup == $1 && curtask->nsproxy->mnt_ns->ns.inum == $2/
{
    printf(
        "EXEC time=%s host_pid=%d ppid=%d uid=%d comm=%s file=%s\n",
        strftime("%Y-%m-%dT%H:%M:%S.%fZ", nsecs),
        pid,
        ppid,
        uid,
        comm,
        str(args.filename)
    );
}

/* All open-family syscalls converge here after a struct file is created. */
kfunc:security_file_open
/cgroup == $1 &&
 curtask->nsproxy->mnt_ns->ns.inum == $2 &&
 ((uint32)args.file->f_flags & O_ACCMODE) == O_RDONLY/
{
    printf(
        "RO time=%s host_pid=%d uid=%d comm=%s path=%s flags=0x%x\n",
        strftime("%Y-%m-%dT%H:%M:%S.%fZ", nsecs),
        pid, uid, comm, path(args.file->f_path), args.file->f_flags
    );
}

kfunc:security_file_open
/cgroup == $1 &&
 curtask->nsproxy->mnt_ns->ns.inum == $2 &&
 (((uint32)args.file->f_flags & O_ACCMODE) == O_WRONLY ||
  ((uint32)args.file->f_flags & O_ACCMODE) == O_RDWR)/
{
    printf(
        "RW time=%s host_pid=%d uid=%d comm=%s path=%s flags=0x%x\n",
        strftime("%Y-%m-%dT%H:%M:%S.%fZ", nsecs),
        pid, uid, comm, path(args.file->f_path), args.file->f_flags
    );
}
