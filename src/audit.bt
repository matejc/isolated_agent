#!/usr/bin/env bpftrace

#define O_ACCMODE 00000003
#define O_RDONLY  00000000
#define O_WRONLY  00000001
#define O_RDWR    00000002

BEGIN
{
    printf("Tracing container cgroup ID %llu\n", $1);
}


/*
 * Executed programs
 */
tracepoint:syscalls:sys_enter_execve
/cgroup == $1/
{
    printf(
        "EXEC time=%s host_pid=%d ppid=%d uid=%d comm=%s file=%s args=",
        strftime("%Y-%m-%dT%H:%M:%S.%fZ", nsecs),
        pid,
        ppid,
        uid,
        comm,
        str(args.filename)
    );
    join(args.argv);
}

tracepoint:syscalls:sys_enter_execveat
/cgroup == $1/
{
    printf(
        "EXECAT time=%s host_pid=%d ppid=%d uid=%d comm=%s file=%s args=",
        strftime("%Y-%m-%dT%H:%M:%S.%fZ", nsecs),
        pid,
        ppid,
        uid,
        comm,
        str(args.filename)
    );
    join(args.argv);
}

/* File-open intent, classified by the requested access mode. */
tracepoint:syscalls:sys_enter_openat
/cgroup == $1 &&
 ((uint32)args.flags & O_ACCMODE) == O_RDONLY/
{
    printf(
        "RO time=%s host_pid=%d uid=%d comm=%s path=%s flags=0x%x\n",
        strftime("%Y-%m-%dT%H:%M:%S.%fZ", nsecs),
        pid,
        uid,
        comm,
        str(args.filename),
        args.flags
    );
}

tracepoint:syscalls:sys_enter_openat
/cgroup == $1 &&
 (((uint32)args.flags & O_ACCMODE) == O_WRONLY ||
  ((uint32)args.flags & O_ACCMODE) == O_RDWR)/
{
    printf(
        "RW time=%s host_pid=%d uid=%d comm=%s path=%s flags=0x%x\n",
        strftime("%Y-%m-%dT%H:%M:%S.%fZ", nsecs),
        pid,
        uid,
        comm,
        str(args.filename),
        args.flags
    );
}
